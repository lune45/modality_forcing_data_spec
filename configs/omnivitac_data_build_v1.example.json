{
  "schema_version": "modality_forcing_v1",
  "dataset_source": "omnivitac",
  "source_root": "/absolute/path/to/processed_dataset",
  "output_dir": "../outputs",
  "vae_index": {
    "camera": "camera2",
    "strict_camera": true,
    "frame_stride": 3,
    "n_frames": 17,
    "clips_per_episode": 25,
    "trans_thresh_mm": 1.0,
    "rot_thresh_rad": 0.01,
    "with_stats_before_split": false,
    "seed": 0
  },
  "split": {
    "activity_modality": "contact",
    "train_weight": 1000,
    "test_weight": 200,
    "active_frac": 0.85,
    "seed": 0
  },
  "physical_statistics": {
    "source": "train_clip_index_only",
    "n_sample_frames": 3000,
    "deduplicate": true,
    "seed": 0
  },
  "pipeline": {
    "camera": "camera2",
    "action_stride": 3,
    "train_statistics_only": true,
    "require_explicit_physical_paths": true
  },
  "mixture": {
    "random_seed": 42,
    "task_ratios": {
      "T0": 0.4,
      "T1": 0.2,
      "T2": 0.2,
      "T3": 0.2
    }
  },
  "expected_future_frames": 16,
  "expected_action_dim": 7,
  "check_file_exists": true,
  "check_array_content": true
}
